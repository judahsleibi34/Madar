#!/usr/bin/env python3
"""Installed immutable release and post-acceptance migration controller.

Release promotion never applies or reverses a database migration. An explicit
automatic mode may apply an opted-in expand manifest only after the bridge SHA
has independently become known-good.
"""

from __future__ import annotations

