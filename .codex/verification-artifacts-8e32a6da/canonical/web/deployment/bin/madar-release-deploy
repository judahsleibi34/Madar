from dataclasses import replace
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from html.parser import HTMLParser
from pathlib import Path
from contextlib import contextmanager
from datetime import datetime, timedelta

SCRIPT = Path(__file__).resolve()
WEB_ROOT = SCRIPT.parents[2]
sys.path.insert(0, str(WEB_ROOT))

from deployment.lib.release_deployer import Compatibility, ReleaseDeployer, atomic_json, utc_now  # noqa: E402
from deployment.lib.environment_file import load_environment_file  # noqa: E402
from deployment.lib.control_plane_upgrade_authorization import (  # noqa: E402
    require_upgrade_authorization,
)
from deployment.lib.migration_executor import (  # noqa: E402
    LockedMigrationExecutor,
    MigrationManifest,
)


SLOT_PORTS = {
    "blue": {"backend": "8101", "frontend": "3100", "redis": "6381"},
    "green": {"backend": "8201", "frontend": "3200", "redis": "6382"},
}

SLOT_SUBNETS = {
    "blue": {
        "default": "10.252.0.0/24",
        "parser": "10.252.1.0/24",
        "remote_internal": "10.252.2.0/24",
        "remote_egress": "10.252.3.0/24",
    },
    "green": {
        "default": "10.252.4.0/24",
        "parser": "10.252.5.0/24",
        "remote_internal": "10.252.6.0/24",
        "remote_egress": "10.252.7.0/24",
    },
}

PRODUCTION_PATH_KEYS = (
    "MADAR_PRODUCTION_REPO",
    "MADAR_ENV_FILE",
    "MADAR_DEPLOY_STATE_ROOT",
    "MADAR_STORAGE_ROOT",
    "MADAR_ACTIVE_UPSTREAMS_FILE",
    "MADAR_PROXY_CONFIG_ROOT",
    "MADAR_CONTROL_PLANE_ROOT",
    "MADAR_RELEASE_DEPLOY_BIN",
    "MADAR_PRODUCTION_DEPLOY_BIN",
    "MADAR_TRAFFIC_SWITCH_COMMAND",
    "MADAR_MIGRATION_BACKUP_SCRIPT",
    "MADAR_MIGRATION_BACKUP_VERIFY_SCRIPT",
    "MADAR_CANONICAL_GIT_REMOTE",
)

ACCEPTED_READINESS_STATES = {
    "ok", "disabled", "configured", "not_required", "development",
}
ACTIVE_REFRESH_COMPONENTS = {
    "notification_worker",
    "calendar_sync_worker",
    "data_deletion_worker",
    "parser_isolation",
}
ACTIVE_REFRESH_CORE_COMPONENTS = {
    "environment",
    "database",
    "redis",
    "auth",
    "storage",
    "schema",
}

def load_production_path_contract(*, installed: bool | None = None) -> dict[str, str]:
    """Apply the tracked path contract before production configuration."""

    contract_file = WEB_ROOT / "deployment" / "production-paths.conf"
    contract: dict[str, str] = {}
    load_environment_file(
        contract_file,
        environ=contract,
        require_private=False,
    )
    missing = [name for name in PRODUCTION_PATH_KEYS if not contract.get(name)]
    if missing:
        raise RuntimeError("production_path_contract_incomplete")
    if installed is None:
        installed = SCRIPT.resolve() == Path(contract["MADAR_RELEASE_DEPLOY_BIN"]).resolve()
    for name in PRODUCTION_PATH_KEYS:
        if installed:
            os.environ[name] = contract[name]
        else:
            os.environ.setdefault(name, contract[name])
    return contract


def load_active_runtime_environment(env_file: Path) -> set[str]:
    """Load active-service configuration while preserving canonical paths."""

    runtime: dict[str, str] = {}
    loaded = load_environment_file(env_file, environ=runtime)
    for name, value in runtime.items():
        if name not in PRODUCTION_PATH_KEYS:
            os.environ[name] = value
    return loaded


def supabase_server_headers(key: str) -> dict[str, str]:
    """Keep opaque Supabase API keys out of the JWT Authorization header."""
    headers = {"apikey": key}
    if not key.startswith("sb_secret_"):
        headers["Authorization"] = f"Bearer {key}"
    return headers


class ScriptSourceParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.sources: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag != "script":
            return
        attributes = dict(attrs)
        source = str(attributes.get("src") or "").strip()
        if source:
            self.sources.append(source)


class DockerGitOperations:
    def __init__(
        self,
        repo: Path,
        state_root: Path,
        env_file: Path,
        compatibility: Compatibility,
    ):
        self.repo = repo
        self.state_root = state_root
        self.env_file = env_file
        self.compatibility = compatibility
        self.release_root: Path | None = None

    @staticmethod
    def _storage_root() -> Path:
        raw = os.getenv("MADAR_STORAGE_ROOT", "").strip()
        if not raw:
            raise RuntimeError("production_storage_root_not_configured")
        root = Path(raw)
        if not root.is_absolute() or root == Path("/"):
            raise RuntimeError("production_storage_root_invalid")
        return root.resolve()

    def run(self, command: list[str], *, cwd: Path | None = None, env: dict[str, str] | None = None, capture: bool = False) -> str:
        completed = subprocess.run(
            command, cwd=cwd, env=env, check=True, text=True,
            stdout=subprocess.PIPE if capture else None,
        )
        return completed.stdout.strip() if capture else ""

    def verify_source(self, sha: str) -> None:
        if self.run(["git", "status", "--porcelain", "--untracked-files=normal"], cwd=self.repo, capture=True):
            raise RuntimeError("production_worktree_dirty")
        self.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"], cwd=self.repo)
        release_root = self.state_root / "releases" / sha
        if not release_root.exists():
            release_root.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            self.run(["git", "worktree", "add", "--detach", str(release_root), sha], cwd=self.repo)
        actual = self.run(["git", "rev-parse", "HEAD"], cwd=release_root, capture=True)
        if actual != sha:
            raise RuntimeError("release_worktree_identity_mismatch")
        if self.run(
            ["git", "status", "--porcelain", "--untracked-files=normal"],
            cwd=release_root,
            capture=True,
        ):
            raise RuntimeError("release_worktree_dirty")
        attached = subprocess.run(
            ["git", "symbolic-ref", "-q", "HEAD"],
            cwd=release_root,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if attached.returncode == 0:
            raise RuntimeError("release_worktree_not_detached")
        self.release_root = release_root

    def _digest(self, tag: str) -> str:
        image_id = self.run(["docker", "image", "inspect", "--format", "{{.Id}}", tag], capture=True)
        if not image_id.startswith("sha256:"):
            raise RuntimeError("docker_image_digest_unavailable")
        return f"{tag}@{image_id}"

    def _existing_artifact(
        self, tag: str, sha: str, *, expected_labels: dict[str, str] | None = None,
    ) -> tuple[str, str] | None:
        try:
            raw = self.run(
                ["docker", "image", "inspect", "--format", "{{json .Config.Labels}}", tag],
                capture=True,
            )
            labels = json.loads(raw) if raw else {}
        except (subprocess.CalledProcessError, ValueError):
            return None
        if not isinstance(labels, dict) or labels.get("com.madar.release.sha") != sha:
            return None
        if expected_labels and any(labels.get(name) != value for name, value in expected_labels.items()):
            return None
        built_at = str(labels.get("com.madar.release.built_at") or "").strip()
        if not built_at:
            return None
        return self._digest(tag), built_at

    def build(self, sha: str, slot: str) -> dict[str, str]:
        if self.release_root is None:
            raise RuntimeError("release_source_not_prepared")
        build_timestamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        backend_tag = f"madar-backend:{sha}"
        staging = bool(os.getenv("MADAR_COMPOSE_OVERRIDE", "").strip())
        frontend_target = "staging" if staging else "production"
        frontend_api_url = os.getenv("VITE_API_URL", "").strip().rstrip("/")
        expected_api_url = "http://127.0.0.1:18001" if staging else "https://api.madarportal.com"
        if frontend_api_url != expected_api_url:
            raise RuntimeError("frontend_api_origin_missing_or_invalid")
        frontend_tag = f"madar-frontend:{sha}-{frontend_target}"
        existing_backend = self._existing_artifact(backend_tag, sha)
        existing_frontend = self._existing_artifact(
            frontend_tag, sha,
            expected_labels={"com.madar.frontend.api_origin": frontend_api_url},
        )
        if existing_backend and existing_frontend:
            if existing_backend[1] != existing_frontend[1]:
                raise RuntimeError("release_artifact_timestamp_mismatch")
            return {
                "backend": existing_backend[0],
                "frontend": existing_frontend[0],
                "worker": existing_backend[0],
                "build_timestamp": existing_backend[1],
                "artifact_reused": True,
            }
        labels = ["--label", f"com.madar.release.sha={sha}", "--label", f"com.madar.release.built_at={build_timestamp}"]
        self.run([
            "docker", "build", *labels, "--build-arg", f"MADAR_RELEASE_SHA={sha}",
            "--build-arg", f"MADAR_BUILD_TIMESTAMP={build_timestamp}", "-t", backend_tag,
            str(self.release_root / "web/backend"),
        ])
        frontend_labels = [
            *labels, "--label", f"com.madar.frontend.api_origin={frontend_api_url}",
        ]
        self.run([
            "docker", "build", *frontend_labels,
            "--build-arg", f"VITE_API_URL={frontend_api_url}",
            "--build-arg", f"MADAR_REQUIRE_PRODUCTION_API_URL={'false' if staging else 'true'}",
            "--build-arg", f"MADAR_RELEASE_SHA={sha}",
            "--build-arg", f"MADAR_BUILD_TIMESTAMP={build_timestamp}", "-t", frontend_tag,
            str(self.release_root / "web/frontend"),
        ])
        return {
            "backend": self._digest(backend_tag),
            "frontend": self._digest(frontend_tag),
            "worker": self._digest(backend_tag),
            "build_timestamp": build_timestamp,
            "artifact_reused": False,
        }

    @staticmethod
    def _expected_frontend_api_url() -> str:
        return (
            "http://127.0.0.1:18001"
            if os.getenv("MADAR_COMPOSE_OVERRIDE", "").strip()
            else "https://api.madarportal.com"
        )

    def schema_version(self) -> int:
        url = os.environ["SUPABASE_URL"].rstrip("/") + "/rest/v1/application_schema_state?select=schema_version&contract_key=eq.core&limit=1"
        key = os.environ["SUPABASE_SERVICE_KEY"]
        request = urllib.request.Request(url, headers=supabase_server_headers(key))
        with urllib.request.urlopen(request, timeout=5) as response:
            rows = json.loads(response.read())
        if not isinstance(rows, list) or len(rows) != 1:
            raise RuntimeError("schema_state_missing")
        return int(rows[0]["schema_version"])

    def _environment(
        self, sha: str, slot: str, images: dict[str, str], *, workers_active: bool = False,
    ) -> dict[str, str]:
        if self.release_root is None:
            raise RuntimeError("release_source_not_prepared")
        ports = SLOT_PORTS[slot]
        subnets = SLOT_SUBNETS[slot]
        env = dict(os.environ)
        env.update({
            "MADAR_ENV_FILE": str(self.env_file),
            "MADAR_SLOT": slot,
            "MADAR_RELEASE_SHA": sha,
            "MADAR_BUILD_TIMESTAMP": images["build_timestamp"],
            "MADAR_BACKEND_IMAGE": images["backend"].split("@", 1)[0],
            "MADAR_FRONTEND_IMAGE": images["frontend"].split("@", 1)[0],
            "MADAR_BACKEND_BIND_PORT": ports["backend"],
            "MADAR_FRONTEND_BIND_PORT": ports["frontend"],
            "MADAR_REDIS_BIND_PORT": ports["redis"],
            "MADAR_DEFAULT_SUBNET": subnets["default"],
            "MADAR_PARSER_SUBNET": subnets["parser"],
            "MADAR_REMOTE_INTERNAL_SUBNET": subnets["remote_internal"],
            "MADAR_REMOTE_EGRESS_SUBNET": subnets["remote_egress"],
            "SCHEMA_COMPATIBLE_MIN": str(self.compatibility.schema_min),
            "SCHEMA_COMPATIBLE_MAX": str(self.compatibility.schema_max),
            "MADAR_RELEASE_WORKERS_ACTIVE": "true" if workers_active else "false",
            "NOTIFICATION_WORKER_REQUIRED": "true" if workers_active else "false",
            "DATA_DELETION_WORKER_REQUIRED": "true" if workers_active and self.schema_version() >= 83 else "false",
            "DATA_DELETION_WORKER_HEALTH_URL": "http://data-deletion-worker:8094/health",
        })
        # The inactive candidate deliberately has no queue consumers. Its
        # backend must validate core dependencies without interpreting the
        # active release's worker feature flags from the shared env file as a
        # missing-candidate-worker outage. These flags are restored explicitly
        # when the candidate workers are activated for cutover.
        env["NOTIFICATION_WORKER_ENABLED"] = "true" if workers_active else "false"
        env["DATA_DELETION_WORKER_ENABLED"] = (
            "true" if workers_active and self.schema_version() >= 83 else "false"
        )
        env["CALENDAR_SYNC_WORKER_ENABLED"] = "true" if workers_active else "false"
        if not workers_active:
            env["CALENDAR_FEATURE_ENABLED"] = "false"
            env["CALENDAR_SYNC_REQUIRED"] = "false"
        env["MADAR_STORAGE_ROOT"] = str(self._storage_root())
        return env

    def _compose(
        self, sha: str, slot: str, images: dict[str, str], *args: str,
        workers_active: bool = False,
    ) -> None:
        if self.release_root is None:
            raise RuntimeError("release_source_not_prepared")
        web = self.release_root / "web"
        files = ["-f", str(web / "docker-compose.yml")]
        override = os.getenv("MADAR_COMPOSE_OVERRIDE", "").strip()
        if override:
            files.extend(["-f", str(Path(override).resolve())])
        else:
            files.extend(["-f", str(WEB_ROOT / "deployment" / "docker-compose.release.yml")])
        profiles = ["--profile", "workers"]
        if self.schema_version() >= 83:
            profiles.extend(["--profile", "deletion-worker"])
        self.run([
            "docker", "compose", "--project-name", f"madar-{slot}",
            "--project-directory", str(web), "--env-file", str(self.env_file),
            *files, *profiles, *args,
        ], cwd=web, env=self._environment(sha, slot, images, workers_active=workers_active))

    def preflight(self, sha: str, slot: str, images: dict[str, str], schema: int) -> None:
        if self.release_root is None:
            raise RuntimeError("release_source_not_prepared")

        candidate_compatibility = Compatibility.load(
            self.release_root / "web/deployment/releases/release.json"
        )
        if candidate_compatibility != self.compatibility:
            raise RuntimeError("control_plane_release_contract_mismatch")

        for component in ("backend", "frontend", "worker"):
            recorded = str(images[component])
            tag, separator, expected_id = recorded.partition("@")
            if separator != "@" or self._digest(tag) != f"{tag}@{expected_id}":
                raise RuntimeError(f"candidate_image_identity_changed:{component}")
        self._compose(sha, slot, images, "config", "--quiet")
        self.run([sys.executable, str(self.release_root / "web/scripts/check_migrations.py")])
        self.run([
            sys.executable,
            str(self.release_root / "web/scripts/check_migration_transitions.py"),
        ])
        self.run([
            sys.executable,
            str(self.release_root / "web/scripts/check_secret_hygiene.py"),
        ])
        storage_root = self._storage_root()
        for relative in ("uploads", "avatar_uploads", "private_uploads", "private_generated_charts"):
            path = storage_root / relative
            # The deploy operator may intentionally have read/traverse only;
            # the runtime UID/GID owns write access. Candidate readiness performs
            # the authoritative write probe from inside the container.
            if not path.is_dir() or not os.access(path, os.R_OK | os.X_OK):
                raise RuntimeError(f"storage_unavailable:{relative}")

    def start_candidate(self, sha: str, slot: str, images: dict[str, str]) -> None:
        # Queue consumers must not run in the inactive slot. Parser/remote
        # workers are slot-local and cannot see the active slot's Redis queue.
        self._compose(
            # The inactive slot may have been created by an older Compose
            # topology. Recreate every candidate service so Docker cannot try
            # to restart a retained container that still references a removed
            # legacy project network.
            sha, slot, images, "up", "-d", "--no-build", "--force-recreate", "--wait",
            "--wait-timeout", "180", "redis", "parser-worker",
            "remote-ingestion-worker", "backend", "frontend",
        )

    def activate_workers(self, sha: str, slot: str, images: dict[str, str]) -> None:
        services = ["backend", "notification-worker", "calendar-sync-worker"]
        if self.schema_version() >= 83:
            services.append("data-deletion-worker")
        self._compose(
            sha, slot, images, "up", "-d", "--no-build", "--force-recreate",
            "--wait", "--wait-timeout", "180", *services, workers_active=True,
        )

    def refresh_active_runtime_services(
        self, sha: str, slot: str, images: dict[str, str],
    ) -> None:
        """Recreate only active services whose runtime environment is mutable."""

        services = [
            "parser-worker",
            "backend",
            "notification-worker",
            "calendar-sync-worker",
        ]
        if self.schema_version() >= 83:
            services.append("data-deletion-worker")
        self._compose(
            sha, slot, images, "up", "-d", "--no-build", "--force-recreate",
            "--wait", "--wait-timeout", "180", *services,
            workers_active=True,
        )

    @staticmethod
    def _worker_names(slot: str) -> list[str]:
        return [
            f"madar-{slot}-notification-worker",
            f"madar-{slot}-calendar-sync-worker",
            f"madar-{slot}-data-deletion-worker",
        ]

    def deactivate_workers(self, release: dict) -> None:
        slot = str(release.get("slot") or "")
        if slot not in SLOT_PORTS:
            raise RuntimeError("worker_release_slot_invalid")
        subprocess.run(
            ["docker", "stop", *self._worker_names(slot)], check=False,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )

    def restore_workers(self, release: dict) -> None:
        slot = str(release.get("slot") or "")
        if slot not in SLOT_PORTS:
            raise RuntimeError("worker_release_slot_invalid")
        existing: list[str] = []
        for name in self._worker_names(slot):
            inspected = subprocess.run(
                ["docker", "inspect", name], check=False,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            if inspected.returncode == 0:
                existing.append(name)
        if not existing:
            raise RuntimeError("retained_worker_containers_missing")
        self.run(["docker", "start", *existing])

    def _json(self, url: str) -> dict:
        with urllib.request.urlopen(url, timeout=5) as response:
            return json.loads(response.read())

    def _json_allow_unready(self, url: str) -> dict:
        try:
            return self._json(url)
        except urllib.error.HTTPError as error:
            if error.code != 503:
                raise
            return json.loads(error.read())

    def _container_state(self, name: str) -> tuple[str, str, str] | None:
        completed = subprocess.run(
            [
                "docker", "inspect", "--format",
                "{{.Image}}|{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}",
                name,
            ],
            check=False, text=True, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        if completed.returncode != 0:
            return None
        value = completed.stdout.strip()
        parts = value.split("|", 2)
        if len(parts) != 3:
            raise RuntimeError("active_runtime_container_state_invalid")
        return parts[0], parts[1], parts[2]

    @staticmethod
    def _recorded_image_id(images: dict[str, str], component: str) -> str:
        _tag, separator, image_id = str(images.get(component) or "").partition("@")
        if separator != "@" or not image_id.startswith("sha256:"):
            raise RuntimeError(f"immutable_image_digest_missing:{component}")
        return image_id

    def _validate_refresh_health_payload(
        self, *, sha: str, readiness: dict, identity: dict,
    ) -> None:
        if identity.get("release_sha") != sha:
            raise RuntimeError("active_refresh_release_identity_mismatch")
        if (
            str(identity.get("schema_compatible_min"))
            != str(self.compatibility.schema_min)
            or str(identity.get("schema_compatible_max"))
            != str(self.compatibility.schema_max)
        ):
            raise RuntimeError("active_refresh_schema_contract_mismatch")
        components = readiness.get("components")
        if not isinstance(components, dict):
            raise RuntimeError("active_refresh_readiness_invalid")
        if any(components.get(name) != "ok" for name in ACTIVE_REFRESH_CORE_COMPONENTS):
            raise RuntimeError("active_refresh_core_prerequisite_failed")
        degraded = sorted(
            name for name, state in components.items()
            if state not in ACCEPTED_READINESS_STATES
            and name not in ACTIVE_REFRESH_COMPONENTS
        )
        if degraded:
            raise RuntimeError(
                "active_refresh_nonrepairable_readiness:" + ",".join(degraded[:12])
            )

    def validate_active_refresh_prerequisites(
        self, sha: str, slot: str, images: dict[str, str],
    ) -> None:
        """Validate serving identity while allowing only refreshable outages."""

        backend_id = self._recorded_image_id(images, "backend")
        frontend_id = self._recorded_image_id(images, "frontend")
        worker_id = self._recorded_image_id(images, "worker")
        required = {
            f"madar-{slot}-backend": backend_id,
            f"madar-{slot}-frontend": frontend_id,
            f"madar-{slot}-redis": None,
            f"madar-{slot}-remote-ingestion-worker": worker_id,
        }
        for name, expected_id in required.items():
            state = self._container_state(name)
            if state is None or state[1:] != ("running", "healthy"):
                raise RuntimeError(f"active_refresh_prerequisite_unhealthy:{name}")
            if expected_id is not None and state[0] != expected_id:
                raise RuntimeError(f"active_refresh_image_identity_mismatch:{name}")
        for service in (
            "parser-worker", "notification-worker", "calendar-sync-worker",
            "data-deletion-worker",
        ):
            name = f"madar-{slot}-{service}"
            state = self._container_state(name)
            if state is not None and state[0] != worker_id:
                raise RuntimeError(f"active_refresh_image_identity_mismatch:{name}")

        ports = SLOT_PORTS[slot]
        readiness = self._json_allow_unready(
            f"http://127.0.0.1:{ports['backend']}/health/ready"
        )
        identity = self._json(f"http://127.0.0.1:{ports['backend']}/health/version")
        self._validate_refresh_health_payload(
            sha=sha, readiness=readiness, identity=identity,
        )
        stable_readiness = self._json_allow_unready(
            "http://127.0.0.1:8001/health/ready"
        )
        stable_identity = self._json("http://127.0.0.1:8001/health/version")
        self._validate_refresh_health_payload(
            sha=sha, readiness=stable_readiness, identity=stable_identity,
        )
        frontend_base = f"http://127.0.0.1:{ports['frontend']}"
        with urllib.request.urlopen(f"{frontend_base}/", timeout=5) as response:
            if response.status != 200:
                raise RuntimeError("active_refresh_frontend_unavailable")
            self._validate_frontend_api_origin(frontend_base, response.read())
        with urllib.request.urlopen("http://127.0.0.1:3000/", timeout=5) as response:
            if response.status != 200:
                raise RuntimeError("active_refresh_stable_frontend_unavailable")

    def validate_stable_candidate(self, sha: str) -> None:
        stable_identity = self._json("http://127.0.0.1:8001/health/version")
        stable_readiness = self._json("http://127.0.0.1:8001/health/ready")
        if stable_identity.get("release_sha") != sha or not stable_readiness.get("ready"):
            raise RuntimeError("stable_proxy_active_refresh_validation_failed")
        with urllib.request.urlopen("http://127.0.0.1:3000/", timeout=5) as response:
            if response.status != 200:
                raise RuntimeError("stable_proxy_frontend_validation_failed")

    def _validate_frontend_api_origin(self, frontend_base: str, html: bytes) -> None:
        parser = ScriptSourceParser()
        parser.feed(html.decode("utf-8", errors="strict"))
        expected = self._expected_frontend_api_url().encode("utf-8")
        for source in parser.sources:
            # Candidate validation only follows Vite assets on the already
            # loopback-bound candidate frontend. It never follows an arbitrary
            # URL supplied by HTML.
            if not source.startswith("/assets/") or not source.endswith(".js"):
                continue
            with urllib.request.urlopen(f"{frontend_base}{source}", timeout=5) as response:
                if expected in response.read(16 * 1024 * 1024):
                    return
        raise RuntimeError("candidate_frontend_api_origin_mismatch")

    def validate_candidate(self, sha: str, slot: str) -> None:
        ports = SLOT_PORTS[slot]
        attempts = max(1, min(int(os.getenv("MADAR_CANDIDATE_READY_ATTEMPTS", "12")), 60))
        delay = max(1, min(int(os.getenv("MADAR_CANDIDATE_READY_RETRY_SECONDS", "5")), 30))
        last_failure = "candidate_unavailable"
        for attempt in range(1, attempts + 1):
            try:
                readiness = self._json(f"http://127.0.0.1:{ports['backend']}/health/ready")
                identity = self._json(f"http://127.0.0.1:{ports['backend']}/health/version")
                if not readiness.get("ready"):
                    components = readiness.get("components") or {}
                    degraded = sorted(name for name, state in components.items() if state not in {"ok", "disabled", "configured", "not_required", "development"})
                    last_failure = "readiness:" + ",".join(degraded[:12])
                elif identity.get("release_sha") != sha:
                    last_failure = "release_identity_mismatch"
                elif (
                    str(identity.get("schema_compatible_min"))
                    != str(self.compatibility.schema_min)
                    or str(identity.get("schema_compatible_max"))
                    != str(self.compatibility.schema_max)
                ):
                    last_failure = "release_schema_contract_mismatch"
                else:
                    frontend_base = f"http://127.0.0.1:{ports['frontend']}"
                    with urllib.request.urlopen(f"{frontend_base}/", timeout=5) as response:
                        if response.status == 200:
                            self._validate_frontend_api_origin(frontend_base, response.read())
                            return
                    last_failure = "frontend_unavailable"
            except urllib.error.HTTPError as error:
                last_failure = f"http_{error.code}"
                if error.code == 503:
                    try:
                        payload = json.loads(error.read())
                        components = payload.get("components") or {}
                        degraded = sorted(name for name, state in components.items() if state not in {"ok", "disabled", "configured", "not_required", "development"})
                        if degraded:
                            last_failure = "readiness:" + ",".join(degraded[:12])
                    except (TypeError, ValueError):
                        pass
            except (OSError, ValueError):
                last_failure = "candidate_unavailable"
            if attempt < attempts:
                time.sleep(delay)
        raise RuntimeError(f"candidate_deep_validation_failed:{last_failure}")

    def validate_rollback_target(self, release: dict, schema: int) -> dict[str, int]:
        slot = str(release.get("slot") or "")
        expected_sha = str(release.get("sha") or "")
        if slot not in SLOT_PORTS or len(expected_sha) != 40:
            raise RuntimeError("known_good_release_identity_invalid")
        identity = self._json(f"http://127.0.0.1:{SLOT_PORTS[slot]['backend']}/health/version")
        minimum = int(identity.get("schema_compatible_min", -1))
        maximum = int(identity.get("schema_compatible_max", -1))
        if identity.get("release_sha") != expected_sha:
            raise RuntimeError("known_good_release_identity_mismatch")
        if not minimum <= schema <= maximum:
            raise RuntimeError("known_good_rollback_schema_incompatible")
        return {"compatible_min": minimum, "compatible_max": maximum}

    def switch_traffic(self, slot: str) -> None:
        command = os.getenv("MADAR_TRAFFIC_SWITCH_COMMAND", "").strip()
        if not command:
            raise RuntimeError("traffic_switch_command_not_configured")
        attempts = max(1, min(int(os.getenv("MADAR_TRAFFIC_SWITCH_ATTEMPTS", "12")), 60))
        delay = max(1, min(int(os.getenv("MADAR_TRAFFIC_SWITCH_RETRY_SECONDS", "5")), 30))
        last_error: subprocess.CalledProcessError | None = None
        for attempt in range(1, attempts + 1):
            try:
                self.run([command, slot])
                return
            except subprocess.CalledProcessError as error:
                last_error = error
                if attempt < attempts:
                    time.sleep(delay)
        raise RuntimeError(f"traffic_switch_failed_after_{attempts}_attempts") from last_error

    def observe(self, sha: str, slot: str) -> None:
        deadline = time.monotonic() + max(10, int(os.getenv("MADAR_RELEASE_OBSERVE_SECONDS", "60")))
        while time.monotonic() < deadline:
            self.validate_candidate(sha, slot)
            time.sleep(5)

    def stop_candidate(self, slot: str) -> None:
        if self.release_root is None:
            return
        # Only the isolated inactive Compose project is removed. Images and the
        # retained active target are deliberately untouched.
        files = ["-f", str(self.release_root / "web/docker-compose.yml")]
        override = os.getenv("MADAR_COMPOSE_OVERRIDE", "").strip()
        if override:
            files.extend(["-f", str(Path(override).resolve())])
        else:
            files.extend(["-f", str(WEB_ROOT / "deployment" / "docker-compose.release.yml")])
        environment = dict(os.environ)
        subnets = SLOT_SUBNETS[slot]
        environment.update({
            "MADAR_SLOT": slot,
            "MADAR_DEFAULT_SUBNET": subnets["default"],
            "MADAR_PARSER_SUBNET": subnets["parser"],
            "MADAR_REMOTE_INTERNAL_SUBNET": subnets["remote_internal"],
            "MADAR_REMOTE_EGRESS_SUBNET": subnets["remote_egress"],
        })
        subprocess.run([
            "docker", "compose", "--project-name", f"madar-{slot}",
            "--project-directory", str(self.release_root / "web"),
            "--env-file", str(self.env_file), *files,
            "--profile", "workers", "--profile", "deletion-worker", "down", "--remove-orphans",
        ], check=False, env=environment)


def prepared_release_path(state_root: Path) -> Path:
    return state_root / "prepared-release.json"


@contextmanager
def deployment_lock(state_root: Path):
    state_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (state_root / "deploy.lock").open("a+", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError("deployment_already_running") from error
        yield


def prepare_release(
    *, sha: str, slot: str, state_root: Path, compatibility: Compatibility,
    operations: DockerGitOperations,
) -> dict:
    if slot not in SLOT_PORTS:
        raise RuntimeError("candidate_slot_invalid")
    with deployment_lock(state_root):
        operations.verify_source(sha)
        images = operations.build(sha, slot)
        if any("@sha256:" not in str(images.get(name) or "") for name in ("backend", "frontend", "worker")):
            raise RuntimeError("immutable_image_digest_missing")
        schema = operations.schema_version()
        if not compatibility.schema_min <= schema <= compatibility.schema_max:
            raise RuntimeError("candidate_schema_incompatible")
        record = {
            "release_sha": sha,
            "candidate_slot": slot,
            "images": images,
            "schema": schema,
            "status": "preparing",
            "prepared_at": utc_now().isoformat(),
        }
        try:
            operations.preflight(sha, slot, images, schema)
            operations.start_candidate(sha, slot, images)
            operations.validate_candidate(sha, slot)
        except Exception:
            operations.stop_candidate(slot)
            raise
        record["status"] = "candidate_validated_workers_inactive"
        atomic_json(prepared_release_path(state_root), record)
        return record


def load_prepared_release(state_root: Path, sha: str, slot: str) -> dict:
    try:
        record = json.loads(prepared_release_path(state_root).read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise RuntimeError("prepared_release_missing_or_invalid") from error
    if record.get("release_sha") != sha or record.get("candidate_slot") != slot:
        raise RuntimeError("prepared_release_identity_mismatch")
    if record.get("status") not in {
        "candidate_validated_workers_inactive", "candidate_workers_active",
    }:
        raise RuntimeError("prepared_release_state_invalid")
    return record


def activate_prepared_release(
    *, sha: str, slot: str, state_root: Path, operations: DockerGitOperations,
) -> dict:
    record = load_prepared_release(state_root, sha, slot)
    operations.verify_source(sha)
    operations.validate_candidate(sha, slot)
    try:
        operations.activate_workers(sha, slot, record["images"])
        operations.validate_candidate(sha, slot)
    except Exception:
        operations.deactivate_workers({"sha": sha, "slot": slot, "images": record["images"]})
        raise
    record["status"] = "candidate_workers_active"
    record["workers_activated_at"] = utc_now().isoformat()
    atomic_json(prepared_release_path(state_root), record)
    return record


def adopt_prepared_release(
    *, sha: str, slot: str, state_root: Path, compatibility: Compatibility,
    operations: DockerGitOperations,
) -> dict:
    record = load_prepared_release(state_root, sha, slot)
    if record.get("status") != "candidate_workers_active":
        raise RuntimeError("prepared_release_workers_not_active")
    state_file = state_root / "state.json"
    try:
        existing = json.loads(state_file.read_text(encoding="utf-8"))
    except FileNotFoundError:
        existing = {}
    except ValueError as error:
        raise RuntimeError("release_state_invalid") from error
    if existing.get("known_good_release") or existing.get("in_progress_release"):
        raise RuntimeError("immutable_release_state_already_initialized")
    operations.verify_source(sha)
    operations.validate_candidate(sha, slot)
    schema = operations.schema_version()
    if not compatibility.schema_min <= schema <= compatibility.schema_max:
        raise RuntimeError("candidate_schema_incompatible")
    stable_identity = operations._json("http://127.0.0.1:8001/health/version")
    stable_readiness = operations._json("http://127.0.0.1:8001/health/ready")
    if stable_identity.get("release_sha") != sha or not stable_readiness.get("ready"):
        raise RuntimeError("stable_proxy_release_validation_failed")
    with urllib.request.urlopen("http://127.0.0.1:3000/", timeout=5) as response:
        if response.status != 200:
            raise RuntimeError("stable_proxy_frontend_validation_failed")
    known_good = {
        "sha": sha,
        "slot": slot,
        "images": record["images"],
        "schema": schema,
        "schema_compatible_min": compatibility.schema_min,
        "schema_compatible_max": compatibility.schema_max,
    }
    adopted = {
        "release_sha": sha,
        "candidate_slot": slot,
        "traffic_target": slot,
        "images": record["images"],
        "schema": {"observed": schema},
        "status": "known_good",
        "phase": "bootstrap_adopted",
        "completed_at": utc_now().isoformat(),
    }
    state = {
        "active_slot": slot,
        "known_good_release": known_good,
        "failed_releases": existing.get("failed_releases") or {},
        "history": [adopted],
    }
    atomic_json(state_file, state)
    prepared_release_path(state_root).unlink()
    return adopted


def _refresh_active_runtime(
    *, sha: str, slot: str, state_root: Path, operations: DockerGitOperations,
    allow_schema_advance: bool, event_phase: str,
) -> dict:
    state_file = state_root / "state.json"
    try:
        state = json.loads(state_file.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise RuntimeError("release_state_missing_or_invalid") from error
    known_good = state.get("known_good_release") or {}
    if (
        state.get("active_slot") != slot
        or known_good.get("sha") != sha
        or known_good.get("slot") != slot
    ):
        raise RuntimeError("active_release_identity_mismatch")
    if state.get("in_progress_release") or state.get("rollback_failure"):
        raise RuntimeError("active_release_recovery_state_present")
    schema = operations.schema_version()
    if schema < 83:
        raise RuntimeError("data_deletion_worker_schema_not_ready")
    recorded_schema = int(known_good.get("schema", -1))
    if allow_schema_advance:
        if schema < recorded_schema:
            raise RuntimeError("active_release_schema_mismatch")
    elif schema != recorded_schema:
        raise RuntimeError("active_release_schema_mismatch")
    if not operations.compatibility.schema_min <= schema <= operations.compatibility.schema_max:
        raise RuntimeError("active_release_schema_incompatible")
    operations.verify_source(sha)
    operations.preflight(sha, slot, known_good["images"], schema)
    operations.validate_active_refresh_prerequisites(sha, slot, known_good["images"])
    operations.refresh_active_runtime_services(sha, slot, known_good["images"])
    operations.validate_candidate(sha, slot)
    operations.validate_stable_candidate(sha)
    known_good["schema"] = schema
    event = {
        "release_sha": sha, "candidate_slot": slot, "traffic_target": slot,
        "schema": {"observed": schema}, "status": "known_good",
        "phase": event_phase,
        "completed_at": utc_now().isoformat(),
    }
    state.setdefault("history", []).append(event)
    atomic_json(state_file, state)
    return event


def refresh_active_workers(
    *, sha: str, slot: str, state_root: Path, operations: DockerGitOperations,
) -> dict:
    return _refresh_active_runtime(
        sha=sha, slot=slot, state_root=state_root, operations=operations,
        allow_schema_advance=True,
        event_phase="post_migration_workers_refreshed",
    )


def refresh_active_runtime(
    *, sha: str, slot: str, state_root: Path, operations: DockerGitOperations,
) -> dict:
    return _refresh_active_runtime(
        sha=sha, slot=slot, state_root=state_root, operations=operations,
        allow_schema_advance=False,
        event_phase="active_runtime_refreshed",
    )


AUTOMATIC_MIGRATION_POLICY = (
    "automatic-after-known-good-backup-first-forward-repair"
)


def _json_file(path: Path, failure_code: str) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise RuntimeError(failure_code) from error
    if not isinstance(value, dict):
        raise RuntimeError(failure_code)
    return value


def _validate_stable_known_good(
    *, sha: str, slot: str, operations: DockerGitOperations,
) -> None:
    operations.validate_candidate(sha, slot)
    identity = operations._json("http://127.0.0.1:8001/health/version")
    readiness = operations._json("http://127.0.0.1:8001/health/ready")
    if identity.get("release_sha") != sha or not readiness.get("ready"):
        raise RuntimeError("stable_bridge_validation_failed")
    with urllib.request.urlopen("http://127.0.0.1:3000/", timeout=5) as response:
        if response.status != 200:
            raise RuntimeError("stable_bridge_frontend_validation_failed")


def _create_verified_migration_backup(
    *, sha: str, known_good: dict, storage_root: Path,
) -> Path:
    backup_root_raw = os.getenv("MADAR_BACKUP_DIR", "").strip()
    if not backup_root_raw:
        raise RuntimeError("automatic_migration_backup_root_missing")
    if not Path(backup_root_raw).is_absolute():
        raise RuntimeError("automatic_migration_backup_root_invalid")
    backup_root = Path(backup_root_raw).resolve()
    if backup_root == Path("/"):
        raise RuntimeError("automatic_migration_backup_root_invalid")

    installed_scripts = SCRIPT.parents[1] / "scripts"
    default_scripts = installed_scripts if installed_scripts.is_dir() else WEB_ROOT / "scripts"
    backup_script = Path(
        os.getenv(
            "MADAR_MIGRATION_BACKUP_SCRIPT",
            str(default_scripts / "backup_madar.sh"),
        )
    ).resolve()
    verify_script = Path(
        os.getenv(
            "MADAR_MIGRATION_BACKUP_VERIFY_SCRIPT",
            str(default_scripts / "verify_backup.sh"),
        )
    ).resolve()
    if not backup_script.is_file() or not os.access(backup_script, os.X_OK):
        raise RuntimeError("automatic_migration_backup_script_unavailable")
    if not verify_script.is_file() or not os.access(verify_script, os.X_OK):
        raise RuntimeError("automatic_migration_backup_verifier_unavailable")

    environment = dict(os.environ)
    environment.pop("MADAR_BACKUP_TIMESTAMP", None)
    environment.update({
        "MADAR_RELEASE_SHA": sha,
        "MADAR_BUILD_TIMESTAMP": str(
            (known_good.get("images") or {}).get("build_timestamp") or "unknown"
        ),
        "MADAR_BUILDER_ASSETS_DIR": str(storage_root / "uploads"),
        "MADAR_PRIVATE_UPLOADS_DIR": str(storage_root / "private_uploads"),
        "MADAR_GENERATED_ARTIFACTS_DIR": str(
            storage_root / "private_generated_charts"
        ),
        "MADAR_AVATARS_DIR": str(storage_root / "avatar_uploads"),
    })
    completed = subprocess.run(
        [str(backup_script)], check=True, text=True, env=environment,
        stdout=subprocess.PIPE,
    )
    output = [line.strip() for line in completed.stdout.splitlines() if line.strip()]
    if len(output) != 1:
        raise RuntimeError("automatic_migration_backup_output_invalid")
    backup = Path(output[0]).resolve()
    if (
        backup.parent != backup_root
        or not re.fullmatch(r"madar-[0-9]{8}T[0-9]{6}Z", backup.name)
        or not backup.is_dir()
    ):
        raise RuntimeError("automatic_migration_backup_path_invalid")
    subprocess.run([str(verify_script), str(backup)], check=True)
    return backup


def _attest_migration_backup(
    backup: Path, *, release_sha: str, source_schema: int,
) -> None:
    manifest = _json_file(
        backup / "manifest.json",
        "automatic_migration_backup_manifest_invalid",
    )
    if (
        manifest.get("format_version") != 3
        or manifest.get("status") != "complete"
        or manifest.get("backup_id") != backup.name
        or (manifest.get("release") or {}).get("git_sha") != release_sha
        or str((manifest.get("database") or {}).get("schema_version"))
        != str(source_schema)
    ):
        raise RuntimeError("automatic_migration_backup_identity_mismatch")


def automatic_migrate_known_good(
    *, sha: str, state_root: Path, compatibility: Compatibility,
    operations: DockerGitOperations,
) -> dict:
    """Apply an opted-in manifest only after ``sha`` is durable known-good.

    The caller holds ``deploy.lock`` for backup, execution, and post-migration
    validation. Migration errors are forward-repair events and never enter the
    release promotion rollback state machine.
    """
    if len(sha) != 40 or any(char not in "0123456789abcdef" for char in sha):
        raise ValueError("automatic migration release must be a full lowercase Git SHA")
    state_file = state_root / "state.json"
    state = _json_file(state_file, "release_state_missing_or_invalid")
    known_good = state.get("known_good_release") or {}
    slot = str(known_good.get("slot") or "")
    if (
        known_good.get("sha") != sha
        or slot not in SLOT_PORTS
        or state.get("active_slot") != slot
    ):
        raise RuntimeError("automatic_migration_bridge_not_known_good")
    if state.get("in_progress_release") or state.get("rollback_failure"):
        raise RuntimeError("automatic_migration_release_recovery_required")

    operations.verify_source(sha)
    if operations.release_root is None:
        raise RuntimeError("release_source_not_prepared")
    release_root = operations.release_root
    installed_metadata = _json_file(
        WEB_ROOT / "deployment/releases/release.json",
        "installed_release_contract_invalid",
    )
    candidate_metadata = _json_file(
        release_root / "web/deployment/releases/release.json",
        "candidate_release_contract_invalid",
    )
    if installed_metadata != candidate_metadata:
        raise RuntimeError("automatic_migration_release_contract_mismatch")
    policy = str(candidate_metadata.get("migration_policy") or "")
    if policy != AUTOMATIC_MIGRATION_POLICY:
        return {
            "release_sha": sha,
            "status": "not_requested",
            "phase": "manual_or_no_migration_policy",
        }
    if compatibility.migration_class not in {"expand-only", "forward-compatible"}:
        raise RuntimeError("automatic_migration_release_class_rejected")
    # Keep ordinary promotion independent of the migration-only database
    # client. A missing runtime dependency rejects this opted-in path before
    # backup creation or database access without disabling application deploys.
    try:
        import psycopg
    except ImportError as error:
        raise RuntimeError("automatic_migration_database_client_unavailable") from error

    manifest_name = str(candidate_metadata.get("migration_manifest") or "").strip()
    if (
        not manifest_name.startswith("migrations-")
        or not manifest_name.endswith(".json")
        or Path(manifest_name).name != manifest_name
    ):
        raise RuntimeError("automatic_migration_manifest_invalid")
    installed_manifest_path = WEB_ROOT / "deployment/releases" / manifest_name
    candidate_manifest_path = (
        release_root / "web/deployment/releases" / manifest_name
    )
    if _json_file(
        installed_manifest_path, "installed_migration_manifest_invalid"
    ) != _json_file(
        candidate_manifest_path, "candidate_migration_manifest_invalid"
    ):
        raise RuntimeError("automatic_migration_manifest_contract_mismatch")
    manifest = MigrationManifest.load(candidate_manifest_path, release_root)
    if manifest.release_sha in {"CURRENT", "STAGING"}:
        manifest = replace(manifest, release_sha=sha)
    elif manifest.release_sha != sha:
        raise RuntimeError("automatic_migration_manifest_release_mismatch")
    source_schema = manifest.migrations[0].from_schema
    target_schema = manifest.migrations[-1].to_schema
    if target_schema != compatibility.target_schema:
        raise RuntimeError("automatic_migration_target_contract_mismatch")
    if not (
        compatibility.schema_min <= source_schema <= target_schema
        <= compatibility.schema_max
    ):
        raise RuntimeError("automatic_migration_bridge_range_invalid")

    # Checksum-pin every SQL input before backup creation or database access.
    LockedMigrationExecutor(
        connection_factory=lambda: None,
        manifest=manifest,
        state_file=state_root / "migrations" / sha / "execution.json",
        backup_dir=Path("/nonexistent"),
        backup_verifier=lambda _path: None,
    ).verify_migrations()

    # Re-run immutable deterministic migration gates immediately before any
    # backup or database access, even though promotion preflight ran them too.
    operations.run([
        sys.executable, str(release_root / "web/scripts/check_migrations.py"),
    ])
    operations.run([
        sys.executable,
        str(release_root / "web/scripts/check_migration_transitions.py"),
    ])
    _validate_stable_known_good(sha=sha, slot=slot, operations=operations)
    current_schema = operations.schema_version()
    if not compatibility.schema_min <= current_schema <= compatibility.schema_max:
        raise RuntimeError("automatic_migration_live_schema_incompatible")
    if current_schema < source_schema or current_schema > target_schema:
        raise RuntimeError(f"automatic_migration_unexpected_schema:{current_schema}")

    acceptance = next(
        (
            event for event in reversed(state.get("history") or [])
            if isinstance(event, dict)
            and event.get("release_sha") == sha
            and event.get("status") == "known_good"
            and event.get("phase") == "complete"
        ),
        None,
    )
    if current_schema == source_schema:
        if not (
            compatibility.rollback_schema_min <= current_schema
            <= compatibility.rollback_schema_max
        ):
            raise RuntimeError("automatic_migration_rollback_contract_invalid")
        retained = (
            acceptance.get("previous_known_good_release")
            if isinstance(acceptance, dict)
            else None
        )
        if not isinstance(retained, dict):
            raise RuntimeError("automatic_migration_retained_rollback_attestation_missing")
        retained_sha = str(retained.get("sha") or "")
        if (
            len(retained_sha) != 40
            or any(char not in "0123456789abcdef" for char in retained_sha)
            or retained.get("slot") == slot
            or int(retained.get("schema_compatible_min", current_schema + 1))
            > current_schema
            or int(retained.get("schema_compatible_max", current_schema - 1))
            < current_schema
        ):
            raise RuntimeError("automatic_migration_retained_rollback_attestation_invalid")
        # Promotion recorded the attestation, but the retained process must
        # still be alive, identify as that exact SHA, and support the source
        # schema immediately before an irreversible forward-only phase starts.
        operations.validate_rollback_target(retained, current_schema)

    migration_root = state_root / "migrations" / sha
    automation_file = migration_root / "automation.json"
    execution_file = migration_root / "execution.json"
    prior_automation = (
        _json_file(automation_file, "automatic_migration_state_invalid")
        if automation_file.exists()
        else {}
    )
    retry_after_raw = str(prior_automation.get("retry_after") or "")
    if prior_automation.get("status") == "failed_forward_repair_required" and retry_after_raw:
        try:
            if utc_now() < datetime.fromisoformat(retry_after_raw):
                return {
                    **prior_automation,
                    "phase": "retry_suppressed",
                }
        except (TypeError, ValueError) as error:
            raise RuntimeError("automatic_migration_retry_state_invalid") from error
    if prior_automation.get("status") == "completed":
        if (
            current_schema != target_schema
            or prior_automation.get("release_sha") != sha
            or str(prior_automation.get("target_schema")) != str(target_schema)
            or str(prior_automation.get("observed_schema")) != str(target_schema)
        ):
            raise RuntimeError("automatic_migration_completed_state_invalid")
        return prior_automation

    backup: Path | None = None
    prior_execution = (
        _json_file(execution_file, "automatic_migration_execution_state_invalid")
        if execution_file.exists()
        else {}
    )
    acceptance_schema = (
        acceptance.get("schema") if isinstance(acceptance, dict) else None
    )
    if (
        current_schema == target_schema
        and not automation_file.exists()
        and not execution_file.exists()
        and str(known_good.get("schema")) == str(target_schema)
        and isinstance(acceptance_schema, dict)
        and str(acceptance_schema.get("observed"))
        == str(target_schema)
    ):
        # A later application release may be accepted after an earlier release
        # already completed this manifest's target. Prove that the target was
        # observed during this release's own promotion and that this SHA owns no
        # migration state before recording a durable no-op. Any current-release
        # state instead enters the release-bound resume checks below.
        result = {
            "release_sha": sha,
            "source_schema": source_schema,
            "target_schema": target_schema,
            "observed_schema": current_schema,
            "backup": None,
            "execution_status": "already_at_target",
            "status": "completed",
            "phase": "already_at_target",
            "completed_at": utc_now().isoformat(),
            "failure_semantics": "not_required_already_at_target",
        }
        atomic_json(automation_file, result)
        return result
    prior_backup = str((prior_execution.get("backup") or {}).get("path") or "")
    if prior_backup:
        if not Path(prior_backup).is_absolute():
            raise RuntimeError("automatic_migration_resume_backup_invalid")
        candidate_backup = Path(prior_backup).resolve()
        backup_root_raw = os.getenv("MADAR_BACKUP_DIR", "").strip()
        if not backup_root_raw:
            raise RuntimeError("automatic_migration_backup_root_missing")
        backup_root = Path(backup_root_raw).resolve()
        if (
            backup_root == Path("/")
            or candidate_backup.parent != backup_root
            or not re.fullmatch(
                r"madar-[0-9]{8}T[0-9]{6}Z", candidate_backup.name
            )
            or not candidate_backup.is_dir()
            or prior_execution.get("release_sha") != sha
            or (prior_execution.get("backup") or {}).get("verified") is not True
        ):
            raise RuntimeError("automatic_migration_resume_backup_invalid")
        backup = candidate_backup
    elif current_schema > source_schema:
        raise RuntimeError("automatic_migration_resume_backup_attestation_missing")

    installed_scripts = SCRIPT.parents[1] / "scripts"
    default_scripts = installed_scripts if installed_scripts.is_dir() else WEB_ROOT / "scripts"
    verifier = Path(
        os.getenv(
            "MADAR_MIGRATION_BACKUP_VERIFY_SCRIPT",
            str(default_scripts / "verify_backup.sh"),
        )
    ).resolve()

    def verify_backup(path: Path) -> None:
        subprocess.run([str(verifier), str(path.resolve())], check=True)

    automation = {
        "release_sha": sha,
        "source_schema": source_schema,
        "target_schema": target_schema,
        "backup": str(backup) if backup is not None else None,
        "started_at": str(
            prior_automation.get("started_at") or utc_now().isoformat()
        ),
        "attempted_at": utc_now().isoformat(),
        "phase": "backup_creation" if backup is None else "migration_execution",
        "status": "running",
        "failure_semantics": "forward_repair_only",
    }
    atomic_json(automation_file, automation)
    try:
        if backup is None:
            backup = _create_verified_migration_backup(
                sha=sha,
                known_good=known_good,
                storage_root=Path(
                    os.getenv("MADAR_STORAGE_ROOT", "/var/lib/madar/storage")
                ).resolve(),
            )
            automation["backup"] = str(backup)
            automation["phase"] = "migration_execution"
            atomic_json(automation_file, automation)
        _attest_migration_backup(
            backup, release_sha=sha, source_schema=source_schema,
        )
        executor = LockedMigrationExecutor(
            connection_factory=lambda: psycopg.connect(
                os.getenv("MADAR_MIGRATION_DATABASE_URL", "")
            ),
            manifest=manifest,
            state_file=execution_file,
            backup_dir=backup,
            backup_verifier=verify_backup,
        )
        execution_result = executor.run()
        automation["phase"] = "post_migration_validation"
        atomic_json(automation_file, automation)
        if operations.schema_version() != target_schema:
            raise RuntimeError("automatic_migration_target_not_observed")
        # Recreate schema-gated workers and revalidate both the active slot and
        # stable proxy before updating known-good's observed schema.
        refresh_event = refresh_active_workers(
            sha=sha, slot=slot, state_root=state_root, operations=operations,
        )
        result = {
            "release_sha": sha,
            "source_schema": source_schema,
            "target_schema": target_schema,
            "observed_schema": target_schema,
            "backup": str(backup) if backup is not None else None,
            "execution_status": execution_result["status"],
            "status": "completed",
            "phase": "post_migration_validation_complete",
            "completed_at": utc_now().isoformat(),
            "failure_semantics": "forward_repair_only",
            "refresh_event": refresh_event,
        }
        atomic_json(automation_file, result)
        return result
    except Exception as error:
        try:
            configured_retry = int(
                os.getenv("MADAR_MIGRATION_RETRY_MINUTES", "15")
            )
        except ValueError:
            configured_retry = 15
        retry_minutes = max(5, min(configured_retry, 1440))
        automation.update(
            status="failed_forward_repair_required",
            phase=f"{automation.get('phase', 'migration')}_failed",
            failed_at=utc_now().isoformat(),
            retry_after=(utc_now() + timedelta(minutes=retry_minutes)).isoformat(),
            failure_code=str(error)[:160],
        )
        atomic_json(automation_file, automation)
        raise


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("sha", help="Full candidate Git SHA")
    parser.add_argument("--manual-retry", action="store_true", help="Explicitly clear same-SHA suppression for this run")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--prepare-only", action="store_true", help="Validate an initial inactive candidate without workers or traffic")
    mode.add_argument("--activate-prepared", action="store_true", help="Activate workers for a previously prepared candidate")
    mode.add_argument("--adopt-prepared", action="store_true", help="Adopt a promoted initial candidate as immutable known-good")
    mode.add_argument("--refresh-active-workers", action="store_true", help="Refresh the active release after reaching schema 83")
    mode.add_argument(
        "--refresh-active-runtime", action="store_true",
        help="Safely apply environment changes to the exact active known-good release",
    )
    mode.add_argument("--automatic-migrate", action="store_true", help="Run an opted-in migration only after this SHA is known-good")
    parser.add_argument("--slot", choices=tuple(SLOT_PORTS), default="green")
    args = parser.parse_args()
    normalized_sha = args.sha.lower()
    if not re.fullmatch(r"[0-9a-f]{40}", normalized_sha):
        raise RuntimeError("candidate_sha_invalid")
    require_upgrade_authorization(normalized_sha)
    load_production_path_contract()
    repo = Path(os.environ["MADAR_PRODUCTION_REPO"]).resolve()
    state_root = Path(os.environ["MADAR_DEPLOY_STATE_ROOT"]).resolve()
    env_file = Path(os.environ["MADAR_ENV_FILE"]).resolve()
    if args.refresh_active_workers or args.refresh_active_runtime:
        load_active_runtime_environment(env_file)
    else:
        load_environment_file(env_file)
    compatibility = Compatibility.load(WEB_ROOT / "deployment/releases/release.json")
    operations = DockerGitOperations(repo, state_root, env_file, compatibility)
    if args.automatic_migrate:
        with deployment_lock(state_root):
            result = automatic_migrate_known_good(
                sha=normalized_sha, state_root=state_root,
                compatibility=compatibility, operations=operations,
            )
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0
    if args.prepare_only:
        result = prepare_release(
            sha=normalized_sha, slot=args.slot, state_root=state_root,
            compatibility=compatibility, operations=operations,
        )
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0
    if args.activate_prepared:
        with deployment_lock(state_root):
            result = activate_prepared_release(
                sha=normalized_sha, slot=args.slot, state_root=state_root, operations=operations,
            )
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0
    if args.adopt_prepared:
        with deployment_lock(state_root):
            result = adopt_prepared_release(
                sha=normalized_sha, slot=args.slot, state_root=state_root,
                compatibility=compatibility, operations=operations,
            )
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0
    if args.refresh_active_workers:
        with deployment_lock(state_root):
            result = refresh_active_workers(
                sha=normalized_sha, slot=args.slot, state_root=state_root,
                operations=operations,
            )
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0
    if args.refresh_active_runtime:
        with deployment_lock(state_root):
            result = refresh_active_runtime(
                sha=normalized_sha, slot=args.slot, state_root=state_root,
                operations=operations,
            )
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0
    deployer = ReleaseDeployer(state_root=state_root, compatibility=compatibility, operations=operations)
    result = deployer.deploy(normalized_sha, manual_retry=args.manual_retry)
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
