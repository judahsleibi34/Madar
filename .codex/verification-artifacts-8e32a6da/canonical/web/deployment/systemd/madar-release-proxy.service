[Unit]
Description=Madar stable blue/green release proxy
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=true
User=madar
Group=madar
EnvironmentFile=/opt/madar/control-plane/deployment/production-paths.conf
WorkingDirectory=/opt/madar/control-plane/deployment/proxy
ExecStart=/usr/bin/docker compose --project-name madar-release-proxy --file /opt/madar/control-plane/deployment/proxy/docker-compose.yml up -d --no-build --wait --wait-timeout 90
ExecStop=/usr/bin/docker compose --project-name madar-release-proxy --file /opt/madar/control-plane/deployment/proxy/docker-compose.yml stop
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
