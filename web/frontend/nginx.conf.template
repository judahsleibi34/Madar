map $http_x_forwarded_proto $madar_forwarded_proto {
    default $scheme;
    "http" http;
    "https" https;
}

map $http_x_request_id $madar_request_id {
    default $http_x_request_id;
    "" $request_id;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/conf.d/includes/security_headers.conf;

    # API responses can legitimately end in public asset extensions such as
    # .png, .webp, or .pdf. Make this prefix authoritative so the generic
    # static-file regex below cannot intercept /api/uploads/... and cache a
    # frontend 404 instead of proxying the request to FastAPI.
    location ^~ /api/ {
        proxy_pass http://backend:8000/;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $madar_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $madar_request_id;
    }

    location = /api {
        return 308 /api/;
    }

    location ^~ /uploads/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $madar_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $madar_request_id;
    }

    location ~ "^/site/([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:/(.*))?/?$" {
        rewrite ^/site/([^/]+)(?:/(.*))?/?$ /public/legacy/site/$1/$2 break;
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $madar_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $madar_request_id;
    }

    location ~ "^/store/([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:/(.*))?/?$" {
        rewrite ^/store/([^/]+)(?:/(.*))?/?$ /public/legacy/store/$1/$2 break;
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $madar_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $madar_request_id;
    }

    location ~ "^/forms/([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)/([^/]+)/?$" {
        rewrite ^/forms/([^/]+)/([^/]+)/?$ /public/legacy/forms/$1/$2 break;
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $madar_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $madar_request_id;
    }

    location ~ ^/ecommerce-preview(?:/|$) {
        try_files /index.html =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/conf.d/includes/admin_preview_frame_headers.conf;
    }

    location ~ ^/shop(?:/|$) {
        try_files /index.html =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/conf.d/includes/storefront_frame_headers.conf;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/conf.d/includes/security_headers.conf;
    }

    location = /madar-push-sw.js {
        try_files $uri =404;
        access_log off;
        default_type application/javascript;
        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
        include /etc/nginx/conf.d/includes/security_headers.conf;
    }

    location = /manifest.webmanifest {
        try_files $uri =404;
        access_log off;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache, must-revalidate" always;
        include /etc/nginx/conf.d/includes/security_headers.conf;
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?|pdf)$ {
        try_files $uri =404;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/conf.d/includes/security_headers.conf;
    }
}
