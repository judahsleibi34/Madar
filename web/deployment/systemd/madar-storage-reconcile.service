[Unit]
Description=Madar bounded storage reservation and asset reconciliation
After=network-online.target
OnFailure=madar-ops-alert@%n.service

[Service]
Type=oneshot
User=madar
Group=madar
UMask=0077
EnvironmentFile=/etc/madar/runtime.env
WorkingDirectory=/home/madar/saas/Madar/web/backend
ExecStart=/usr/bin/flock --nonblock /run/lock/madar-storage-reconcile.lock /usr/bin/python3 scripts/reconcile_storage.py --apply --include-assets --limit 100
NoNewPrivileges=true
