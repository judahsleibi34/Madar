[Unit]
Description=Madar verified online Node 1 SSH backup replication
After=network-online.target madar-backup.service
Wants=network-online.target
OnFailure=madar-ops-alert@%n.service
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
User=madar
Group=madar
UMask=0077
Environment=MADAR_BACKUP_DIR=/var/lib/madar/backups
Environment=MADAR_BACKUP_FRESHNESS_MARKER=/var/lib/madar/backups/LATEST
EnvironmentFile=/etc/madar/node1-backup.env
ExecStart=/usr/bin/python3 /usr/local/lib/madar/replicate_latest_node1.py
TimeoutStartSec=125min
Restart=on-failure
RestartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
