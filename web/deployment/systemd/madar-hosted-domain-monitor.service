[Unit]
Description=Check Madar canonical hosted tenant domains through public HTTPS
Wants=network-online.target
After=network-online.target
OnFailure=madar-ops-alert@%n.service

[Service]
Type=oneshot
User=madar
Group=madar
ExecStart=/usr/bin/python3 -I /usr/local/lib/madar/monitor_hosted_domains.py
TimeoutStartSec=90s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
