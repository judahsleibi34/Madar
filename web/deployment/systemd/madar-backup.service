[Unit]
Description=Madar verified local backup generation
After=network-online.target
Wants=network-online.target
OnFailure=madar-ops-alert@%n.service

[Service]
Type=oneshot
User=madar
Group=madar
UMask=0077
LoadCredential=production.env:/etc/madar/production.env
EnvironmentFile=/etc/madar/backup.env
EnvironmentFile=/opt/madar/control-plane/deployment/production-paths.conf
Environment=MADAR_PROVIDER_BACKUP_REQUIRED=true
Environment=MADAR_BACKUP_STATE_DIR=/var/lib/madar/backup-state
ExecStart=/usr/bin/python3 /usr/local/lib/madar/backup_support.py scheduled /usr/local/lib/madar/backup_madar.sh
ExecStartPost=/usr/local/lib/madar/verify_latest_backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
TimeoutStartSec=2h
