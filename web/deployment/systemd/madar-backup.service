[Unit]
Description=Madar verified local backup generation
After=network-online.target
Wants=network-online.target
OnFailure=madar-ops-alert@%n.service

[Service]
Type=oneshot
User=madar
Group=madar
UMask=0077
EnvironmentFile=/etc/madar/backup.env
ExecStart=/usr/local/lib/madar/backup_madar.sh
ExecStartPost=/usr/local/lib/madar/verify_latest_backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
