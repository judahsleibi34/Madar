[Unit]
Description=Deploy an immutable Madar main release when eligible
Wants=network-online.target docker.service madar-release-proxy.service
After=network-online.target docker.service madar-release-proxy.service
OnFailure=madar-ops-alert@%n.service

[Service]
Type=oneshot
User=madar
Group=madar
UMask=0077
WorkingDirectory=/srv/madar/production
EnvironmentFile=/etc/madar/backup.env
EnvironmentFile=/opt/madar/control-plane/deployment/production-paths.conf
Environment=MADAR_TRAFFIC_SWITCH_DRIVER=docker-nginx
Environment=MADAR_PROXY_CONTAINER=madar-release-proxy
ExecStart=/opt/madar/control-plane/deployment/bin/madar-auto-deploy
TimeoutStartSec=45min
NoNewPrivileges=true
