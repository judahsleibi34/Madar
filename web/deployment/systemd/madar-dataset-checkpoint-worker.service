[Unit]
Description=Madar bounded dataset-checkpoint worker batch
After=network-online.target
OnFailure=madar-ops-alert@%n.service

[Service]
Type=oneshot
User=madar
Group=madar
UMask=0077
EnvironmentFile=/etc/madar/runtime.env
WorkingDirectory=/srv/madar/production/web/backend
ExecStart=/usr/bin/flock --nonblock /run/lock/madar-dataset-checkpoint-worker.lock /usr/bin/python3 scripts/run_dataset_checkpoint_worker.py --limit 5 --lease-seconds 900
TimeoutStartSec=30m
MemoryMax=1536M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lock /var/lib/madar/checkpoint-scratch
