#!/usr/bin/env bash
set -Eeuo pipefail

readonly REPO_ROOT="/home/madar/saas/Madar"
readonly ENV_FILE="${MADAR_ENV_FILE:-$REPO_ROOT/.env}"
readonly STORAGE_ROOT="${MADAR_STORAGE_ROOT:-$REPO_ROOT/backend}"
readonly COMPOSE_PROJECT="${MADAR_COMPOSE_PROJECT:-madar}"
readonly LOCK_FILE="/tmp/madar-production-deploy.lock"
readonly LOG_PREFIX="[madar-production]"

readonly BACKEND_HEALTH_URL="http://127.0.0.1:8001/health/ready"
readonly FRONTEND_HEALTH_URL="http://127.0.0.1:3000/"
readonly HEALTH_ATTEMPTS=12
readonly HEALTH_DELAY_SECONDS=5
readonly HEALTH_TIMEOUT_SECONDS=10

# Compose's CLI --env-file controls interpolation; exporting the same absolute
# path also makes each service-level env_file entry resolve identically.
export MADAR_ENV_FILE="$ENV_FILE"
export MADAR_STORAGE_ROOT="$STORAGE_ROOT"

COMPOSE_ROOT=""
COMPOSE_FILE=""
declare -a COMPOSE_ARGS=()

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "$LOG_PREFIX Another deployment is already running."
    exit 0
fi

select_compose_layout() {
    if [[ -f "$REPO_ROOT/web/docker-compose.yml" ]]; then
        COMPOSE_ROOT="$REPO_ROOT/web"
        COMPOSE_FILE="$COMPOSE_ROOT/docker-compose.yml"
    elif [[ -f "$REPO_ROOT/docker-compose.yml" ]]; then
        # Required while rolling back across the monorepo transition.
        COMPOSE_ROOT="$REPO_ROOT"
        COMPOSE_FILE="$REPO_ROOT/docker-compose.yml"
    else
        echo "$LOG_PREFIX ERROR: No supported production Compose file exists."
        return 1
    fi

    COMPOSE_ARGS=(
        --project-name "$COMPOSE_PROJECT"
        --project-directory "$COMPOSE_ROOT"
        --env-file "$ENV_FILE"
        -f "$COMPOSE_FILE"
        --profile workers
    )
}

compose() {
    docker compose "${COMPOSE_ARGS[@]}" "$@"
}

check_health() {
    local service_name="$1"
    local url="$2"
    local attempt

    echo "$LOG_PREFIX Waiting for $service_name at $url"
    for ((attempt = 1; attempt <= HEALTH_ATTEMPTS; attempt++)); do
        if curl --fail --silent --show-error \
            --max-time "$HEALTH_TIMEOUT_SECONDS" "$url" >/dev/null; then
            echo "$LOG_PREFIX $service_name health check passed."
            return 0
        fi
        if ((attempt < HEALTH_ATTEMPTS)); then
            echo "$LOG_PREFIX $service_name not ready ($attempt/$HEALTH_ATTEMPTS). Retrying in ${HEALTH_DELAY_SECONDS}s..."
            sleep "$HEALTH_DELAY_SECONDS"
        fi
    done

    echo "$LOG_PREFIX ERROR: $service_name health check failed after $HEALTH_ATTEMPTS attempts."
    return 1
}

rollback() {
    local previous_commit="$1"

    echo "$LOG_PREFIX Rolling back to $previous_commit"
    git -C "$REPO_ROOT" reset --hard "$previous_commit"

    if ! select_compose_layout; then
        echo "$LOG_PREFIX CRITICAL: Rollback Compose layout is unavailable."
        return 1
    fi

    echo "$LOG_PREFIX Rebuilding previous Docker images"
    if ! compose build; then
        echo "$LOG_PREFIX CRITICAL: Rollback build failed."
        return 1
    fi

    echo "$LOG_PREFIX Restoring previous production containers"
    if ! compose up -d --remove-orphans --wait --wait-timeout 120; then
        echo "$LOG_PREFIX CRITICAL: Rollback container startup failed."
        return 1
    fi

    check_health "Rollback backend" "$BACKEND_HEALTH_URL" || return 1
    check_health "Rollback frontend" "$FRONTEND_HEALTH_URL" || return 1
    echo "$LOG_PREFIX Rollback completed successfully."
}

echo "$LOG_PREFIX Starting production deployment"

if [[ ! -r "$ENV_FILE" ]]; then
    echo "$LOG_PREFIX ERROR: Production environment file is not readable: $ENV_FILE"
    exit 1
fi

CURRENT_BRANCH="$(git -C "$REPO_ROOT" branch --show-current)"
if [[ "$CURRENT_BRANCH" != "main" ]]; then
    echo "$LOG_PREFIX ERROR: Production directory is on '$CURRENT_BRANCH', not main."
    exit 1
fi

# Refuse to overwrite tracked or untracked local work. Ignored production
# secrets and durable storage directories do not appear in this check.
if [[ -n "$(git -C "$REPO_ROOT" status --porcelain --untracked-files=normal)" ]]; then
    echo "$LOG_PREFIX ERROR: Production checkout contains local changes."
    git -C "$REPO_ROOT" status --short
    exit 1
fi

PREVIOUS_COMMIT="$(git -C "$REPO_ROOT" rev-parse HEAD)"

echo "$LOG_PREFIX Fetching origin/main"
git -C "$REPO_ROOT" fetch origin main
TARGET_COMMIT="$(git -C "$REPO_ROOT" rev-parse origin/main)"

if [[ "$PREVIOUS_COMMIT" == "$TARGET_COMMIT" ]]; then
    echo "$LOG_PREFIX Already running the latest main commit:"
    git -C "$REPO_ROOT" log -1 --oneline
    exit 0
fi

if ! git -C "$REPO_ROOT" merge-base --is-ancestor "$PREVIOUS_COMMIT" "$TARGET_COMMIT"; then
    echo "$LOG_PREFIX ERROR: origin/main is not a fast-forward from production."
    exit 1
fi

echo "$LOG_PREFIX Updating production:"
echo "$LOG_PREFIX Previous: $PREVIOUS_COMMIT"
echo "$LOG_PREFIX Target:   $TARGET_COMMIT"
git -C "$REPO_ROOT" reset --hard "$TARGET_COMMIT"

if ! select_compose_layout; then
    git -C "$REPO_ROOT" reset --hard "$PREVIOUS_COMMIT"
    exit 1
fi

echo "$LOG_PREFIX Validating production Compose configuration"
if ! compose config --quiet; then
    echo "$LOG_PREFIX ERROR: Production Compose validation failed."
    git -C "$REPO_ROOT" reset --hard "$PREVIOUS_COMMIT"
    exit 1
fi

echo "$LOG_PREFIX Building new Docker images"
# Existing production containers remain online while the new images build.
if ! compose build; then
    echo "$LOG_PREFIX ERROR: New image build failed."
    git -C "$REPO_ROOT" reset --hard "$PREVIOUS_COMMIT"
    exit 1
fi

# Database migrations are intentionally not automatic. Any migration requires
# the separately reviewed backup, compatibility, and forward-repair procedure.
echo "$LOG_PREFIX Starting updated production containers"
if ! compose up -d --remove-orphans --wait --wait-timeout 120; then
    echo "$LOG_PREFIX ERROR: Container startup failed."
    rollback "$PREVIOUS_COMMIT" || echo "$LOG_PREFIX CRITICAL: Automatic rollback failed."
    exit 1
fi

if ! check_health "Backend readiness" "$BACKEND_HEALTH_URL"; then
    echo "$LOG_PREFIX ERROR: Backend failed after deployment."
    rollback "$PREVIOUS_COMMIT" || echo "$LOG_PREFIX CRITICAL: Automatic rollback failed."
    exit 1
fi

if ! check_health "Frontend" "$FRONTEND_HEALTH_URL"; then
    echo "$LOG_PREFIX ERROR: Frontend failed after deployment."
    rollback "$PREVIOUS_COMMIT" || echo "$LOG_PREFIX CRITICAL: Automatic rollback failed."
    exit 1
fi

echo "$LOG_PREFIX Deployment succeeded"
git -C "$REPO_ROOT" log -1 --oneline
compose ps
