#!/usr/bin/env bash
set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly TRACKED_CONTROL_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
if [[ "$TRACKED_CONTROL_ROOT" == "/opt/madar/control-plane/deployment" ]]; then
    # Interactive production execution receives the same root-owned path
    # contract as systemd. The later file is authoritative by design.
    set -a
    # shellcheck source=../production-paths.conf
    source "$TRACKED_CONTROL_ROOT/production-paths.conf"
    set +a
fi

readonly REPO_ROOT="${MADAR_PRODUCTION_REPO:-/srv/madar/production}"
readonly CONTROL_ROOT="${MADAR_CONTROL_PLANE_ROOT:-/opt/madar/control-plane/deployment}"
readonly RELEASE_DEPLOY="${MADAR_RELEASE_DEPLOY_BIN:-$CONTROL_ROOT/bin/madar-release-deploy}"

if [[ ! -x "$RELEASE_DEPLOY" ]]; then
    echo "[madar-production] ERROR: immutable release deployer is not installed." >&2
    exit 1
fi
if [[ -n "$(git -C "$REPO_ROOT" status --porcelain --untracked-files=normal)" ]]; then
    echo "[madar-production] ERROR: production checkout contains local changes." >&2
    exit 1
fi

git -C "$REPO_ROOT" fetch origin main
readonly TARGET_SHA="$(git -C "$REPO_ROOT" rev-parse origin/main)"
readonly CONTROL_PLANE_GUARD="$CONTROL_ROOT/bin/madar-control-plane-guard"

[[ -x "$CONTROL_PLANE_GUARD" ]] || {
    echo "[madar-production] ERROR: control-plane guard is unavailable." >&2
    exit 1
}
"$CONTROL_PLANE_GUARD" "$TARGET_SHA"

"$RELEASE_DEPLOY" "$TARGET_SHA" "$@"
git -C "$REPO_ROOT" merge --ff-only "$TARGET_SHA"
echo "[madar-production] Production checkout advanced after successful promotion: ${TARGET_SHA:0:12}"

# This is deliberately a second invocation. Release acceptance and all
# blue/green rollback handling are complete before migration automation starts.
# A migration failure therefore leaves the bridge known-good and is retried as
# forward repair by the next auto-deploy cycle.
"$RELEASE_DEPLOY" "$TARGET_SHA" --automatic-migrate
