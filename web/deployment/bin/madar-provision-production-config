#!/usr/bin/env python3
"""Safely provision Madar's mandatory production security configuration.

Dry-run is the default. Output contains variable names and file paths only;
configuration values are never printed, compared in output, or logged.
"""

from __future__ import annotations

import argparse
import os
import re
import secrets
import shutil
import tempfile
from datetime import datetime, timezone
from pathlib import Path


ASSIGNMENT = re.compile(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*(?:=|:)\s*(.*)$")
MANAGED = ("CSRF_SECRET", "ALLOW_REMOTE_DATASET_URLS")


def _inventory(lines: list[str]) -> dict[str, list[int]]:
    found: dict[str, list[int]] = {name: [] for name in MANAGED}
    for index, line in enumerate(lines):
        match = ASSIGNMENT.match(line)
        if match and match.group(1) in found:
            found[match.group(1)].append(index)
    duplicates = [name for name, indexes in found.items() if len(indexes) > 1]
    if duplicates:
        raise RuntimeError("duplicate managed configuration: " + ",".join(sorted(duplicates)))
    return found


def _atomic_write(path: Path, content: str, *, uid: int, gid: int, mode: int) -> None:
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.chown(temporary, uid, gid)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def provision(
    path: Path, backup_dir: Path, *, apply: bool, rotate_csrf: bool = False,
) -> list[str]:
    if not path.is_file():
        raise RuntimeError("production environment file missing")
    metadata = path.stat()
    if metadata.st_mode & 0o077:
        raise RuntimeError("production environment permissions too broad")
    lines = path.read_text(encoding="utf-8").splitlines()
    inventory = _inventory(lines)
    csrf_secret = secrets.token_urlsafe(48)
    changed: list[str] = []
    csrf_indexes = inventory["CSRF_SECRET"]
    if not csrf_indexes or rotate_csrf:
        replacement = f"CSRF_SECRET={csrf_secret}"
        if csrf_indexes:
            lines[csrf_indexes[0]] = replacement
        else:
            lines.append(replacement)
        changed.append("CSRF_SECRET")
    remote_indexes = inventory["ALLOW_REMOTE_DATASET_URLS"]
    remote_replacement = "ALLOW_REMOTE_DATASET_URLS=false"
    if remote_indexes:
        if lines[remote_indexes[0]].strip() != remote_replacement:
            lines[remote_indexes[0]] = remote_replacement
            changed.append("ALLOW_REMOTE_DATASET_URLS")
    else:
        lines.append(remote_replacement)
        changed.append("ALLOW_REMOTE_DATASET_URLS")
    if not apply:
        return changed
    if not changed:
        return changed

    backup_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    if backup_dir.stat().st_mode & 0o077:
        raise RuntimeError("production configuration backup directory permissions too broad")
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = backup_dir / f"{path.name}.{timestamp}.pre-security-provision"
    if backup.exists():
        raise RuntimeError("production configuration backup already exists")
    shutil.copy2(path, backup)
    os.chmod(backup, 0o600)
    os.chown(backup, metadata.st_uid, metadata.st_gid)
    content = "\n".join(lines).rstrip("\n") + "\n"
    _atomic_write(
        path, content, uid=metadata.st_uid, gid=metadata.st_gid,
        mode=metadata.st_mode & 0o777,
    )
    return changed


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--env-file", required=True, type=Path)
    parser.add_argument("--backup-dir", required=True, type=Path)
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--rotate-csrf", action="store_true")
    args = parser.parse_args()
    changed = provision(
        args.env_file.resolve(), args.backup_dir.resolve(),
        apply=args.apply, rotate_csrf=args.rotate_csrf,
    )
    action = "provisioned" if args.apply else "would provision"
    print(f"Madar production configuration {action}: {','.join(changed)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
