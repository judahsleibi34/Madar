#!/usr/bin/env bash
set -Eeuo pipefail

repo="${MADAR_PRODUCTION_REPO:-/home/madar/saas/Madar}"
target_sha="${1:-}"
marker="${MADAR_CONTROL_PLANE_SOURCE_SHA_FILE:-/usr/local/lib/madar/web/deployment/CONTROL_PLANE_SOURCE_SHA}"

die() {
  printf '[madar-control-plane] ERROR: %s\n' "$*" >&2
  exit 1
}

[[ "$target_sha" =~ ^[0-9a-f]{40}$ ]] \
  || die "target SHA is invalid"

[[ -r "$marker" ]] \
  || die "installed control-plane provenance marker missing"

installed_sha="$(tr -d '[:space:]' <"$marker")"

[[ "$installed_sha" =~ ^[0-9a-f]{40}$ ]] \
  || die "installed control-plane provenance marker is invalid"

git -C "$repo" cat-file -e "${installed_sha}^{commit}" 2>/dev/null \
  || die "installed control-plane source commit is unavailable locally"

git -C "$repo" cat-file -e "${target_sha}^{commit}" 2>/dev/null \
  || die "candidate commit is unavailable locally"

declare -a control_plane_paths=(
  web/deployment
  web/scripts/madar_alert_hook.sh
)

if ! git -C "$repo" diff --quiet \
  "$installed_sha" "$target_sha" \
  -- "${control_plane_paths[@]}"; then
  printf '%s\n' \
    "[madar-control-plane] installed source: ${installed_sha}" \
    "[madar-control-plane] candidate source: ${target_sha}" \
    "[madar-control-plane] control-plane changes require root-owned reinstall" >&2
  exit 1
fi

exit 0
