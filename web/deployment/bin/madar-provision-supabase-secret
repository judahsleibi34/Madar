#!/usr/bin/env python3
"""Atomically provision a Supabase Secret API key without command-line exposure."""

from __future__ import annotations

import argparse
import getpass
import os
import re
import shutil
import stat
import tempfile
import time
from pathlib import Path


ASSIGNMENT = re.compile(r"^(\s*SUPABASE_SERVICE_KEY\s*)(=|:)(.*)$")


def validate_secret(value: str) -> None:
    if not value.startswith("sb_secret_"):
        raise RuntimeError("supabase_secret_key_format_invalid")
    if any(character.isspace() or ord(character) < 33 or ord(character) > 126 for character in value):
        raise RuntimeError("supabase_secret_key_format_invalid")


def read_secret_file(path: Path) -> str:
    details = path.lstat()
    if stat.S_ISLNK(details.st_mode) or not stat.S_ISREG(details.st_mode):
        raise RuntimeError("secret_input_must_be_a_regular_file")
    if details.st_mode & 0o077:
        raise RuntimeError("secret_input_permissions_too_broad")
    if details.st_uid not in {0, os.geteuid()}:
        raise RuntimeError("secret_input_owner_invalid")
    lines = path.read_text(encoding="utf-8").splitlines()
    if len(lines) != 1:
        raise RuntimeError("secret_input_must_contain_one_line")
    return lines[0]


def render_environment(original: str, secret: str) -> str:
    lines = original.splitlines(keepends=True)
    matches = [index for index, line in enumerate(lines) if ASSIGNMENT.match(line.rstrip("\r\n"))]
    if len(matches) > 1:
        raise RuntimeError("supabase_service_key_assignment_ambiguous")
    replacement = f"SUPABASE_SERVICE_KEY={secret}\n"
    if matches:
        index = matches[0]
        newline = "\r\n" if lines[index].endswith("\r\n") else "\n"
        prefix, separator, _value = ASSIGNMENT.match(lines[index].rstrip("\r\n")).groups()
        lines[index] = f"{prefix}{separator}{secret}{newline}"
    else:
        if original and not original.endswith(("\n", "\r")):
            lines.append("\n")
        lines.append(replacement)
    return "".join(lines)


def provision(env_file: Path, secret: str, *, timestamp: str | None = None) -> Path:
    validate_secret(secret)
    details = env_file.lstat()
    if stat.S_ISLNK(details.st_mode) or not stat.S_ISREG(details.st_mode):
        raise RuntimeError("production_environment_must_be_a_regular_file")
    if details.st_mode & 0o077:
        raise RuntimeError("production_environment_permissions_too_broad")

    original = env_file.read_text(encoding="utf-8")
    rendered = render_environment(original, secret)
    marker = timestamp or time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    backup = env_file.with_name(f"{env_file.name}.pre-supabase-rotation-{marker}")
    if backup.exists():
        raise RuntimeError("production_environment_backup_exists")

    shutil.copyfile(env_file, backup, follow_symlinks=False)
    os.chmod(backup, stat.S_IMODE(details.st_mode))
    os.chown(backup, details.st_uid, details.st_gid)

    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{env_file.name}.supabase-rotation-",
        dir=env_file.parent,
        text=True,
    )
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, stat.S_IMODE(details.st_mode))
        os.fchown(descriptor, details.st_uid, details.st_gid)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(rendered)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, env_file)
        directory = os.open(env_file.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if temporary.exists():
            temporary.unlink()
    return backup


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Provision SUPABASE_SERVICE_KEY without exposing it in argv or output."
    )
    parser.add_argument(
        "--env-file",
        type=Path,
        default=Path("/etc/madar/production.env"),
    )
    parser.add_argument(
        "--secret-file",
        type=Path,
        help="Read one key from a protected regular file; omit for a hidden prompt.",
    )
    parser.add_argument("--apply", action="store_true")
    args = parser.parse_args()

    secret = (
        read_secret_file(args.secret_file.resolve())
        if args.secret_file
        else getpass.getpass("New Supabase Secret API key: ")
    )
    validate_secret(secret)
    if not args.apply:
        print("Secret input validated; production environment unchanged. Re-run with --apply.")
        return 0
    backup = provision(args.env_file.resolve(), secret)
    print(f"Production environment updated atomically; protected backup: {backup}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
