#!/usr/bin/env bash
set -Eeuo pipefail

readonly REPO_ROOT="/home/madar/saas/Madar"
readonly DEPLOY_SCRIPT="${MADAR_PRODUCTION_DEPLOY_BIN:-/usr/local/lib/madar/web/deployment/bin/madar-production-deploy}"
readonly STATE_ROOT="${MADAR_DEPLOY_STATE_ROOT:-/var/lib/madar/releases}"
readonly -a RUNTIME_PATHS=(
  web/backend
  web/frontend
  web/database
  web/supabase
  web/scripts
  web/docker-compose.yml
  web/docker-compose.dev.yml
  web/deployment
)

if [[ -n "$(git -C "$REPO_ROOT" status --porcelain --untracked-files=normal)" ]]; then
    echo "[madar-auto-deploy] ERROR: production checkout contains local changes." >&2
    exit 1
fi

git -C "$REPO_ROOT" fetch --quiet origin main
readonly TARGET_SHA="$(git -C "$REPO_ROOT" rev-parse origin/main)"
readonly CONTROL_PLANE_GUARD="/usr/local/lib/madar/web/deployment/bin/madar-control-plane-guard"

[[ -x "$CONTROL_PLANE_GUARD" ]] || {
    echo "[madar-auto-deploy] ERROR: control-plane guard is unavailable." >&2
    exit 1
}
"$CONTROL_PLANE_GUARD" "$TARGET_SHA"
readarray -t RELEASE_STATE < <(python3 - "$STATE_ROOT/state.json" "$TARGET_SHA" <<'PY'
import json,sys
from datetime import datetime, timezone
try:
    state=json.load(open(sys.argv[1], encoding='utf-8'))
except (OSError, ValueError):
    state={}
known=(state.get('known_good_release') or {}).get('sha','')
failed=(state.get('failed_releases') or {}).get(sys.argv[2]) or {}
suppressed=False
try:
    suppressed=datetime.fromisoformat(failed.get('retry_after','')) > datetime.now(timezone.utc)
except (TypeError, ValueError):
    pass
print(known)
print('suppressed' if suppressed else 'eligible')
PY
)
readonly KNOWN_GOOD="${RELEASE_STATE[0]:-}"
readonly RELEASE_ELIGIBILITY="${RELEASE_STATE[1]:-eligible}"

if [[ ! "$KNOWN_GOOD" =~ ^[0-9a-f]{40}$ ]]; then
    echo "[madar-auto-deploy] ERROR: immutable release state is not initialized." >&2
    exit 1
fi

if [[ "$TARGET_SHA" == "$KNOWN_GOOD" ]]; then
    echo "[madar-auto-deploy] No update. Known-good release: ${TARGET_SHA:0:12}"
    exit 0
fi

if git -C "$REPO_ROOT" merge-base --is-ancestor "$TARGET_SHA" "$KNOWN_GOOD"; then
    echo "[madar-auto-deploy] Remote main is behind the active known-good release; no action."
    exit 0
fi
if ! git -C "$REPO_ROOT" merge-base --is-ancestor "$KNOWN_GOOD" "$TARGET_SHA"; then
    echo "[madar-auto-deploy] ERROR: origin/main diverges from the active known-good release." >&2
    exit 1
fi
if git -C "$REPO_ROOT" diff --quiet "$KNOWN_GOOD" "$TARGET_SHA" -- "${RUNTIME_PATHS[@]}"; then
    git -C "$REPO_ROOT" merge --ff-only "$TARGET_SHA" >/dev/null
    echo "[madar-auto-deploy] Application-equivalent main advanced without runtime deployment: ${TARGET_SHA:0:12}"
    exit 0
fi
if [[ "$RELEASE_ELIGIBILITY" == "suppressed" ]]; then
    echo "[madar-auto-deploy] Candidate is recorded failed and remains suppressed: ${TARGET_SHA:0:12}"
    exit 0
fi

# The release deployer owns locking, bad-SHA suppression and bounded retry.
exec "$DEPLOY_SCRIPT"
