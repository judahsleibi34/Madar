#!/usr/bin/env bash
# Safe compatibility entrypoint for the currently root-owned systemd wrapper.
# If retained temporarily at the historical /home path, it delegates only to
# the one canonical root-owned controller. It must not host a second copy.
set -Eeuo pipefail

readonly CONTROL_ROOT=/opt/madar/control-plane/deployment
export MADAR_CONTROL_PLANE_ROOT="$CONTROL_ROOT"
export MADAR_PRODUCTION_DEPLOY_BIN="$CONTROL_ROOT/bin/madar-production-deploy"
export MADAR_RELEASE_DEPLOY_BIN="$CONTROL_ROOT/bin/madar-release-deploy"
export MADAR_TRAFFIC_SWITCH_COMMAND="$CONTROL_ROOT/bin/madar-switch-traffic"
export MADAR_PRODUCTION_REPO=/srv/madar/production
export MADAR_DEPLOY_STATE_ROOT=/var/lib/madar/releases
export MADAR_ACTIVE_UPSTREAMS_FILE=/var/lib/madar/proxy/active-upstreams.conf
export MADAR_PROXY_CONFIG_ROOT=/var/lib/madar/proxy
export MADAR_TRAFFIC_SWITCH_DRIVER=docker-nginx
export MADAR_PROXY_CONTAINER=madar-release-proxy
export MADAR_ENV_FILE=/etc/madar/production.env
export MADAR_STORAGE_ROOT=/var/lib/madar/storage

exec "$CONTROL_ROOT/bin/madar-auto-deploy"
