SLOT_PORTS = {
    "blue": {"backend": "8101", "frontend": "3100", "redis": "6381"},
    "green": {"backend": "8201", "frontend": "3200", "redis": "6382"},
}


class RollbackTargetAttestationError(RuntimeError):
    """An expected retained-runtime identity or compatibility rejection."""


