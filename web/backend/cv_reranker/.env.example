POSTGRES_PASSWORD=change_me
POSTGRES_PORT=54329
APP_ENV=development
APP_NAME=cv-reranker
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://cv_ranker:change_me@postgres:5432/cv_ranker
WORKER_DATABASE_URL=postgresql+psycopg://cv_ranker:change_me@postgres:5432/cv_ranker
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=cv-reranker
JWT_AUDIENCE=cv-reranker-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=12
REFRESH_TOKEN_COOKIE=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIRECTORY=/data/uploads
TEMP_DIRECTORY=/data/tmp
MODEL_CACHE_DIRECTORY=/data/models
RERANK_MODEL_ID=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_MODEL_VERSION=default
RERANK_BACKEND=onnx
RERANK_BATCH_SIZE=8
TOP_CHUNKS_FOR_SCORE=3
MATCHING_EXCERPT_COUNT=3
MAX_CONCURRENT_JOBS=1
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
JOB_STALE_AFTER_MINUTES=30
JOB_MAX_ATTEMPTS=3
MAX_FILES_PER_JOB=50
MAX_FILE_SIZE_MB=10
MAX_TOTAL_UPLOAD_MB=200
MAX_BASELINE_CHARACTERS=30000
MAX_CV_CHARACTERS=200000
CHUNK_TOKEN_SIZE=384
CHUNK_TOKEN_OVERLAP=48
MAX_BASELINE_TOKENS=128
CACHE_RETENTION_DAYS=30
CLEANUP_BATCH_SIZE=500
CACHE_ACCESS_UPDATE_INTERVAL_MINUTES=60
DEFAULT_JOB_RETENTION_DAYS=0
MAX_ACTIVE_JOBS_PER_USER=3
MAX_STORED_JOBS_PER_USER=100
RATE_LIMIT_ENABLED=true
REGISTRATION_RATE_LIMIT=10
LOGIN_RATE_LIMIT=20
REFRESH_RATE_LIMIT=30
JOB_CREATE_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=300
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
TORCH_NUM_THREADS=2
