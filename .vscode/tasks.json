{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Madar: Run local backend",
      "type": "process",
      "command": "${workspaceFolder}\\web\\backend\\madar_back\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\web\\backend",
        "env": {
          "APP_ENV": "development",
          "RATE_LIMIT_FAIL_OPEN": "true"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
